Options -Indexes
DirectoryIndex index.html
AddType application/wasm .wasm
AddType text/javascript .mjs
AddType application/octet-stream .onnx
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self'; img-src 'self' blob: data:; style-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "^(index\.html|sw\.js|assets\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
